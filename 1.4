#include <iostream>

class A {
public:
    int a;

    A(int t) : a(t) {}

    int get() {
        return a;
    }

    int operator*=(int mul) {
        a *= mul;
        return a; // Возвращаем значение a
    }
};

int main() {
    A a1(5), a2 = 3;
    a1 *= 10;
    a2 *= a1 *= 2;
    std::cout << a1.get() << " " << a2.get() << std::endl;
    return 0;
}
