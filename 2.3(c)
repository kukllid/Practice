int f(int a = 1) { return a; }
int f(long double a = 5.0) { return a; }

int main() {
    short int s;
    int i;
    bool b;
    float f1 = 1.0f;
    double d = 2.0;

    f(s); // 2: short int -> int
    f(i); //1: f(int i = 1)
    f(b); //2: bool -> int
    f(f1); //2: float -> double 
    f(d); //2: double -> long double
}
